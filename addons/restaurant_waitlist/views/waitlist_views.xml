<odoo>
    <record id="action_restaurant_waitlist" model="ir.actions.act_window">
        <field name="name">Lista de Espera</field>
        <field name="res_model">restaurant.waitlist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer cliente en la lista de espera.
            </p>
        </field>
    </record>

    <record id="view_restaurant_waitlist_tree" model="ir.ui.view">
        <field name="name">restaurant.waitlist.tree</field>
        <field name="model">restaurant.waitlist</field>
        <field name="arch" type="xml">
            <list string="Lista de Espera">
                <field name="customer_name"/>
                <field name="party_size"/>
                <field name="phone"/>
                <field name="table_id"/>
                <field name="state"/>
                <field name="registered_at"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_waitlist_form" model="ir.ui.view">
        <field name="name">restaurant.waitlist.form</field>
        <field name="model">restaurant.waitlist</field>
        <field name="arch" type="xml">
            <form string="Lista de Espera">
                <sheet>
                    <group>
                        <group>
                            <field name="customer_name"/>
                            <field name="party_size"/>
                            <field name="phone"/>
                            <field name="table_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="registered_at"/>
                            <field name="assigned_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Anota observaciones relevantes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_restaurant_waitlist_search" model="ir.ui.view">
        <field name="name">restaurant.waitlist.search</field>
        <field name="model">restaurant.waitlist</field>
        <field name="arch" type="xml">
            <search string="Buscar lista de espera">
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="table_id"/>
                <field name="state"/>
                <filter string="En espera" name="waiting" domain="[('state', '=', 'waiting')]"/>
                <filter string="Asignado" name="seated" domain="[('state', '=', 'seated')]"/>
                <filter string="Cancelado" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_restaurant_waitlist_root"
              name="Lista de Espera"
              sequence="10"/>

    <menuitem id="menu_restaurant_waitlist"
              name="Registros"
              parent="menu_restaurant_waitlist_root"
              action="action_restaurant_waitlist"
              sequence="10"/>
</odoo>
